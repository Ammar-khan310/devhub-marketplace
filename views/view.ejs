<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Files - DevHub</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            margin: 0;
            padding: 40px;
        }

        .container {
            max-width: 1000px;
            margin: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .upload-btn {
            background: #222;
            color: white;
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 6px;
        }

        .upload-btn:hover {
            background: #444;
        }

        .files {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 20px;
        }

        .file-card {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .file-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 7px;
        }

        .pdf {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eee;
            border-radius: 7px;
            font-size: 70px;
        }

        .filename {
            margin-top: 12px;
            font-weight: bold;
            word-break: break-word;
        }

        .view-btn {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 15px;
            background: #222;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

        .empty {
            background: white;
            padding: 40px;
            text-align: center;
            border-radius: 10px;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="header">

        <div>
            <h1>My Files</h1>

            <p>
                Welcome, <strong><%= user.name %></strong>
            </p>
        </div>

        <!-- UPLOAD BUTTON -->
        <a href="/files/upload" class="upload-btn">
            + Upload File
        </a>

    </div>


    <% if (!files || files.length === 0) { %>

        <div class="empty">

            <h2>No files yet</h2>

            <p>
                Upload your first image or PDF.
            </p>

            <a href="/files/upload" class="upload-btn">
                Upload File
            </a>

        </div>

    <% } else { %>

        <div class="files">

            <% files.forEach(file => { %>

                <div class="file-card">

                    <% if (file.contentType.startsWith("image/")) { %>

                        <a
                            href="/files/<%= file._id %>"
                            target="_blank"
                        >
                            <img
                                src="/files/<%= file._id %>"
                                alt="<%= file.filename %>"
                            >
                        </a>

                    <% } else if (file.contentType === "application/pdf") { %>

                        <a
                            href="/files/<%= file._id %>"
                            target="_blank"
                        >
                            <div class="pdf">
                                📄
                            </div>
                        </a>

                    <% } %>


                    <div class="filename">
                        <%= file.filename %>
                    </div>


                    <a
                        href="/files/<%= file._id %>"
                        target="_blank"
                        class="view-btn"
                    >
                        View
                    </a>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>

</body>
</html>
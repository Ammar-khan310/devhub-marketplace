<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>DevHub - My Files</title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f4;
        }


        /* =========================
           LAYOUT
        ========================= */

        .layout {
            display: flex;
            min-height: 100vh;
        }


        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            width: 240px;
            background: #1f1f1f;
            color: white;
            padding: 25px 15px;
        }


        .logo {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 30px;
            padding-left: 10px;
        }


        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 10px;

            padding: 12px 15px;

            color: white;
            text-decoration: none;

            border-radius: 7px;

            margin-bottom: 5px;

            cursor: pointer;
        }


        .sidebar-item:hover {
            background: #333;
        }


        .sidebar-item.active {
            background: #333;
        }


        .folder-list {
            margin-top: 15px;
        }


        .folder-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        /* =========================
           MAIN
        ========================= */

        .main {
            flex: 1;
            padding: 35px;
        }


        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-bottom: 30px;
        }


        .welcome h1 {
            margin: 0 0 8px;
        }


        .welcome p {
            margin: 0;
        }


        .actions {
            display: flex;
            gap: 10px;
        }


        .upload-btn,
        .folder-btn,
        .logout-btn {

            border: none;

            padding: 11px 18px;

            border-radius: 6px;

            text-decoration: none;

            cursor: pointer;

            font-size: 14px;
        }


        .upload-btn {
            background: #222;
            color: white;
        }


        .folder-btn {
            background: #333;
            color: white;
        }


        .logout-btn {
            background: #dc2626;
            color: white;
        }


        .upload-btn:hover {
            background: #444;
        }


        .folder-btn:hover {
            background: #444;
        }


        .logout-btn:hover {
            background: #b91c1c;
        }


        /* =========================
           FILE GRID
        ========================= */

        .files {
            display: grid;

            grid-template-columns:
                repeat(
                    auto-fill,
                    minmax(230px, 1fr)
                );

            gap: 20px;
        }


        .file-card {
            background: white;

            padding: 15px;

            border-radius: 10px;

            box-shadow:
                0 2px 8px rgba(0,0,0,0.1);
        }


        .file-card img {

            width: 100%;

            height: 180px;

            object-fit: cover;

            border-radius: 7px;
        }


        .pdf {

            height: 180px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #eee;

            border-radius: 7px;

            font-size: 70px;
        }


        .filename {

            margin-top: 12px;

            font-weight: bold;

            word-break: break-word;
        }


        .view-btn {

            display: inline-block;

            margin-top: 10px;

            padding: 8px 15px;

            background: #222;

            color: white;

            text-decoration: none;

            border-radius: 5px;
        }


        .delete-btn {

            margin-top: 10px;

            margin-left: 5px;

            padding: 8px 15px;

            background: #dc2626;

            color: white;

            border: none;

            border-radius: 5px;

            cursor: pointer;
        }


        /* =========================
           EMPTY
        ========================= */

        .empty {

            background: white;

            padding: 60px;

            text-align: center;

            border-radius: 10px;
        }


        /* =========================
           MODAL
        ========================= */

        .modal {

            display: none;

            position: fixed;

            inset: 0;

            background:
                rgba(0,0,0,0.75);

            align-items: center;

            justify-content: center;

            z-index: 1000;
        }


        .modal-content {

            position: relative;

            width: 500px;

            max-width: 90%;

            background: #181818;

            color: white;

            padding: 35px;

            border-radius: 20px;
        }


        .modal-content h2 {

            margin-top: 0;

            margin-bottom: 25px;
        }


        .modal-content label {

            display: block;

            font-weight: bold;

            margin-bottom: 8px;
        }


        .modal-content input {

            width: 100%;

            padding: 12px;

            background: #181818;

            color: white;

            border: 1px solid #aaa;

            border-radius: 8px;

            font-size: 16px;
        }


        .close-btn {

            position: absolute;

            right: 20px;

            top: 15px;

            background: none;

            border: none;

            color: white;

            font-size: 30px;

            cursor: pointer;
        }


        .modal-buttons {

            display: flex;

            justify-content: flex-end;

            gap: 10px;

            margin-top: 30px;
        }


        .cancel-btn,
        .create-btn {

            padding: 11px 22px;

            border: none;

            border-radius: 7px;

            cursor: pointer;
        }


        .cancel-btn {

            background: #333;

            color: white;
        }


        .create-btn {

            background: white;

            color: #222;

            font-weight: bold;
        }
        .folder-row {
    display: flex;
    align-items: center;
    gap: 5px;
}

.folder-row .sidebar-item {
    flex: 1;
    margin-bottom: 5px;
}

.delete-folder-btn {
    border: none;
    background: #dc2626;
    color: white;
    width: 35px;
    height: 35px;
    border-radius: 6px;
    cursor: pointer;
    flex-shrink: 0;
}

.delete-folder-btn:hover {
    background: #b91c1c;
}

    </style>

</head>


<body>


<div class="layout">


    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <div class="logo">
            DevHub
        </div>


        <!-- MY FILES -->

        <a
            href="/files"
            class="sidebar-item <%= !currentFolder ? 'active' : '' %>"
        >

            🏠

            <span>
                My Files
            </span>

        </a>


        <!-- FOLDERS -->

<div class="folder-list">

    <% if (folders && folders.length > 0) { %>

        <% folders.forEach(folder => { %>

            <div class="folder-row">

                <a
                    href="/files/folder/<%= folder._id %>"
                    class="sidebar-item <%= currentFolder && currentFolder._id.toString() === folder._id.toString() ? 'active' : '' %>"
                >

                    📁

                    <span class="folder-name">
                        <%= folder.name %>
                    </span>

                </a>

                <button
                    type="button"
                    class="delete-folder-btn"
                    data-folder-id="<%= folder._id %>"
                >
                    🗑
                </button>

            </div>

        <% }) %>

    <% } %>

</div>
    </aside>



    <!-- =========================
         MAIN BODY
    ========================== -->

    <main class="main">


        <!-- TOP BAR -->

        <div class="topbar">


            <div class="welcome">

                <h1>

                    <% if (currentFolder) { %>

                        <%= currentFolder.name %>

                    <% } else { %>

                        My Files

                    <% } %>

                </h1>


                <p>

                    Welcome,
                    <strong>
                        <%= user.name %>
                    </strong>

                </p>

            </div>


            <div class="actions">


                <!-- NEW FOLDER -->

                <button
                    class="folder-btn"
                    onclick="openFolderModal()"
                >

                    + New Folder

                </button>


                <!-- UPLOAD -->

                <a
                    href="<%= currentFolder
                        ? '/files/upload/' + currentFolder._id
                        : '/files/upload'
                    %>"
                    class="upload-btn"
                >

                    + Upload File

                </a>


                <!-- LOGOUT -->

                <a
                    href="/logout"
                    class="logout-btn"
                >

                    Logout

                </a>

            </div>

        </div>



        <!-- =========================
             FILES
        ========================== -->

        <% if (!files || files.length === 0) { %>


            <div class="empty">

                <h2>
                    No files yet
                </h2>


                <p>

                    <% if (currentFolder) { %>

                        Upload a file into this folder.

                    <% } else { %>

                        Upload your first image or PDF.

                    <% } %>

                </p>


                <a
                    href="<%= currentFolder
                        ? '/files/upload/' + currentFolder._id
                        : '/files/upload'
                    %>"
                    class="upload-btn"
                >

                    Upload File

                </a>

            </div>


        <% } else { %>


            <div class="files">


                <% files.forEach(file => { %>


                    <div class="file-card">


                        <% if (
                            file.contentType.startsWith("image/")
                        ) { %>


                            <a
                                href="/files/<%= file._id %>"
                                target="_blank"
                            >

                                <img
                                    src="/files/<%= file._id %>"
                                    alt="<%= file.filename %>"
                                >

                            </a>


                        <% } else if (
                            file.contentType === "application/pdf"
                        ) { %>


                            <a
                                href="/files/<%= file._id %>"
                                target="_blank"
                            >

                                <div class="pdf">

                                    📄

                                </div>

                            </a>


                        <% } %>


                        <div class="filename">

                            <%= file.filename %>

                        </div>


                        <!-- VIEW -->

                        <a
                            href="/files/<%= file._id %>"
                            target="_blank"
                            class="view-btn"
                        >

                            View

                        </a>


                        <!-- DELETE -->

                        <button
                            type="button"
                            class="delete-btn"
                            data-file-id="<%= file._id %>"
                        >

                            Delete

                        </button>


                    </div>


                <% }) %>


            </div>


        <% } %>


    </main>

</div>



<!-- =========================
     NEW FOLDER MODAL
========================= -->

<div
    id="folderModal"
    class="modal"
>


    <div class="modal-content">


        <button
            class="close-btn"
            onclick="closeFolderModal()"
        >

            ×

        </button>


        <h2>
            New folder
        </h2>


        <form
            action="/files/folder/create"
            method="POST"
        >


            <label>
                Folder name
            </label>


            <input
                type="text"
                name="name"
                placeholder="Folder name"
                required
                autofocus
            >


            <div class="modal-buttons">


                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeFolderModal()"
                >

                    Cancel

                </button>


                <button
                    type="submit"
                    class="create-btn"
                >

                    Create

                </button>


            </div>


        </form>

    </div>

</div>



<!-- =========================
     JAVASCRIPT
========================= -->

<script>


function openFolderModal() {

    document.getElementById(
        "folderModal"
    ).style.display = "flex";

}


function closeFolderModal() {

    document.getElementById(
        "folderModal"
    ).style.display = "none";

}


window.addEventListener(
    "click",
    function(event) {

        const modal =
            document.getElementById(
                "folderModal"
            );

        if (event.target === modal) {

            closeFolderModal();

        }

    }
);



/* =========================
   DELETE FILE
========================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {


        const deleteButtons =
            document.querySelectorAll(
                ".delete-btn"
            );


        deleteButtons.forEach(
            function(button) {


                button.addEventListener(
                    "click",
                    async function() {


                        const fileId =
                            button.getAttribute(
                                "data-file-id"
                            );


                        const confirmed =
                            confirm(
                                "Are you sure you want to delete this file?"
                            );


                        if (!confirmed) {
                            return;
                        }


                        try {


                            const response =
                                await fetch(
                                    "/files/" + fileId,
                                    {
                                        method: "DELETE"
                                    }
                                );


                            if (response.ok) {

                                alert(
                                    "File deleted successfully"
                                );

                                window.location.reload();

                            } else {


                                const data =
                                    await response.json();


                                alert(
                                    data.message ||
                                    "Failed to delete file"
                                );

                            }


                        } catch (error) {


                            console.error(
                                "DELETE ERROR:",
                                error
                            );


                            alert(
                                "Something went wrong while deleting the file"
                            );

                        }

                    }
                );

            }
        );

    }
);



/* =========================
   DELETE FOLDER
========================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const deleteFolderButtons =
            document.querySelectorAll(
                ".delete-folder-btn"
            );

        deleteFolderButtons.forEach(
            function(button) {

                button.addEventListener(
                    "click",
                    async function() {

                        const folderId =
                            button.getAttribute(
                                "data-folder-id"
                            );

                        const confirmed =
                            confirm(
                                "Are you sure you want to delete this folder?"
                            );

                        if (!confirmed) {
                            return;
                        }

                        try {

                            const response =
                                await fetch(
                                    "/files/folder/" + folderId,
                                    {
                                        method: "DELETE"
                                    }
                                );

                            if (response.ok) {

                                alert(
                                    "Folder deleted successfully"
                                );

                                window.location.reload();

                            } else {

                                const data =
                                    await response.json();

                                alert(
                                    data.message ||
                                    "Failed to delete folder"
                                );
                            }

                        } catch (error) {

                            console.error(
                                "DELETE FOLDER ERROR:",
                                error
                            );

                            alert(
                                "Something went wrong while deleting the folder"
                            );
                        }

                    }
                );

            }
        );

    }
);
</script>


</body>

</html>
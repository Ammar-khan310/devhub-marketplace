<%- include("../partials/header", {
    title: "Admin Dashboard",
    user
}) %>


<main class="dashboard-container">


    <!-- HEADER -->

    <section class="dashboard-header">

        <div>

            <p class="dashboard-label">
                ADMIN PANEL
            </p>

            <h1>
                Dashboard
            </h1>

            <p class="welcome-text">
                Welcome back,
                <strong><%= user.name %></strong>
            </p>

        </div>


        <div>

            <a
                href="/products"
                class="btn"
            >
                View Marketplace
            </a>

        </div>

    </section>



    <!-- STATISTICS -->

    <section class="stats-grid">


        <div class="stat-card">

            <div class="stat-icon">
                👥
            </div>

            <div>

                <p>
                    Total Users
                </p>

                <h2>
                    <%= stats.users || 0 %>
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                📦
            </div>

            <div>

                <p>
                    Total Products
                </p>

                <h2>
                    <%= stats.products || 0 %>
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                🛒
            </div>

            <div>

                <p>
                    Total Sales
                </p>

                <h2>
                    <%= stats.sales || 0 %>
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                💰
            </div>

            <div>

                <p>
                    Revenue
                </p>

                <h2>
                    $<%= stats.revenue || 0 %>
                </h2>

            </div>

        </div>


    </section>



    <!-- QUICK ACTIONS -->

    <section class="dashboard-section">

        <div class="section-heading">

            <div>

                <h2>
                    Quick Actions
                </h2>

                <p>
                    Manage your marketplace
                </p>

            </div>

        </div>


        <div class="action-grid">


            <a
                href="/admin/products"
                class="action-card"
            >

                <span class="action-icon">
                    📦
                </span>

                <div>

                    <h3>
                        Products
                    </h3>

                    <p>
                        Manage digital products
                    </p>

                </div>

            </a>



            <a
                href="/admin/users"
                class="action-card"
            >

                <span class="action-icon">
                    👥
                </span>

                <div>

                    <h3>
                        Users
                    </h3>

                    <p>
                        Manage users and creators
                    </p>

                </div>

            </a>



            <a
                href="/admin/categories"
                class="action-card"
            >

                <span class="action-icon">
                    📁
                </span>

                <div>

                    <h3>
                        Categories
                    </h3>

                    <p>
                        Manage product categories
                    </p>

                </div>

            </a>



            <a
                href="/admin/reviews"
                class="action-card"
            >

                <span class="action-icon">
                    ⭐
                </span>

                <div>

                    <h3>
                        Reviews
                    </h3>

                    <p>
                        Manage customer reviews
                    </p>

                </div>

            </a>


        </div>

    </section>



    <!-- RECENT ACTIVITIES -->

    <section class="dashboard-section">


        <div class="section-heading">

            <div>

                <h2>
                    Recent Activities
                </h2>

                <p>
                    Latest marketplace activity
                </p>

            </div>

        </div>



        <div class="table-card">

            <table>

                <thead>

                    <tr>

                        <th>
                            User
                        </th>

                        <th>
                            Action
                        </th>

                        <th>
                            Date
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% if (activities && activities.length > 0) { %>


                        <% activities.forEach(activity => { %>

                            <tr>

                                <td>

                                    <strong>
                                        <%= activity.user?.name || "Unknown" %>
                                    </strong>

                                </td>


                                <td>
                                    <%= activity.action %>
                                </td>


                                <td>

                                    <%= new Date(
                                        activity.createdAt
                                    ).toLocaleString() %>

                                </td>

                            </tr>

                        <% }) %>


                    <% } else { %>


                        <tr>

                            <td
                                colspan="3"
                                class="empty"
                            >
                                No recent activities.
                            </td>

                        </tr>


                    <% } %>


                </tbody>

            </table>

        </div>

    </section>


</main>



<style>

.dashboard-container {

    width: 90%;

    max-width: 1200px;

    margin: auto;

    padding: 45px 0;

}


/* HEADER */

.dashboard-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 35px;

}


.dashboard-label {

    color: #2563eb;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.5px;

    margin-bottom: 8px;

}


.dashboard-header h1 {

    font-size: 34px;

    margin-bottom: 8px;

}


.welcome-text {

    color: #6b7280;

}


/* STATS */

.stats-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;

    margin-bottom: 45px;

}


.stat-card {

    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    padding: 23px;

    display: flex;

    align-items: center;

    gap: 15px;

}


.stat-icon {

    width: 50px;

    height: 50px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #eff6ff;

    border-radius: 10px;

    font-size: 22px;

}


.stat-card p {

    color: #6b7280;

    font-size: 13px;

    margin-bottom: 5px;

}


.stat-card h2 {

    font-size: 27px;

}


/* SECTION */

.dashboard-section {

    margin-bottom: 45px;

}


.section-heading {

    margin-bottom: 20px;

}


.section-heading h2 {

    margin-bottom: 5px;

}


.section-heading p {

    color: #6b7280;

    font-size: 14px;

}


/* ACTIONS */

.action-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;

}


.action-card {

    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    padding: 22px;

    display: flex;

    align-items: center;

    gap: 15px;

    transition: 0.2s;

}


.action-card:hover {

    border-color: #2563eb;

    transform: translateY(-3px);

}


.action-icon {

    font-size: 25px;

}


.action-card h3 {

    margin-bottom: 5px;

}


.action-card p {

    color: #6b7280;

    font-size: 12px;

}


/* TABLE */

.table-card {

    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    overflow: hidden;

}


table {

    width: 100%;

    border-collapse: collapse;

}


th,
td {

    padding: 16px 20px;

    text-align: left;

    border-bottom: 1px solid #e5e7eb;

}


th {

    color: #6b7280;

    font-size: 12px;

    text-transform: uppercase;

}


td {

    font-size: 14px;

}


.empty {

    text-align: center;

    color: #9ca3af;

}


/* RESPONSIVE */

@media (max-width: 950px) {

    .stats-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }

    .action-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }

}


@media (max-width: 600px) {

    .dashboard-header {

        flex-direction: column;

        align-items: flex-start;

        gap: 20px;

    }

    .stats-grid {

        grid-template-columns: 1fr;

    }

    .action-grid {

        grid-template-columns: 1fr;

    }

}

</style>


<%- include("../partials/footer") %>
<%- include("../partials/header", {
    title: "Manage Products",
    // user
}) %>


<main class="products-container">


    <!-- HEADER -->

    <section class="products-header">

        <div>

            <p class="page-label">
                ADMIN PANEL
            </p>

            <h1>
                Products
            </h1>

            <p>
                Manage all digital assets available
                on the marketplace.
            </p>

        </div>


        <a
            href="/admin/products/create"
            class="btn"
        >
            + Add Product
        </a>

    </section>



    <!-- SEARCH -->

    <form
        action="/admin/products"
        method="GET"
        class="search-form"
    >

        <input
            type="text"
            name="search"
            value="<%= search || '' %>"
            placeholder="Search products..."
        >

        <button
            type="submit"
            class="btn"
        >
            Search
        </button>

    </form>



    <!-- PRODUCTS TABLE -->

    <section class="table-card">

        <table>

            <thead>

                <tr>

                    <th>
                        Product
                    </th>

                    <th>
                        Creator
                    </th>

                    <th>
                        Category
                    </th>

                    <th>
                        Price
                    </th>

                    <th>
                        Status
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>


                <% if (products && products.length > 0) { %>


                    <% products.forEach(product => { %>


                        <tr>


                            <!-- PRODUCT -->

                            <td>

                                <div class="product-info">

                                    <img
                                        src="<%= product.coverImage || '/images/default-product.jpg' %>"
                                        alt="<%= product.title %>"
                                    >

                                    <div>

                                        <strong>
                                            <%= product.title %>
                                        </strong>

                                        <small>
                                            ID:
                                            <%= product._id %>
                                        </small>

                                    </div>

                                </div>

                            </td>



                            <!-- CREATOR -->

                            <td>

                                <%= product.creator?.name ||
                                    // product.user?.name ||
                                    "Unknown" %>

                            </td>



                            <!-- CATEGORY -->

                            <td>

                                <%= product.category?.name ||
                                    "Uncategorized" %>

                            </td>



                            <!-- PRICE -->

                            <td>

                                <strong>
                                    $<%= product.price %>
                                </strong>

                            </td>



                            <!-- STATUS -->

                            <td>

                                <% if (
                                    product.status === "Published" ||
                                    !product.status
                                ) { %>

                                    <span class="status published">
                                        Published
                                    </span>

                                <% } else { %>

                                    <span class="status">
                                        <%= product.status %>
                                    </span>

                                <% } %>

                            </td>



                            <!-- ACTIONS -->

                            <td>

                                <div class="actions">

                                    <a
                                        href="/products/<%= product._id %>"
                                        class="view-btn"
                                    >
                                        View
                                    </a>


                                    <a
                                        href="/admin/products/<%= product._id %>/edit"
                                        class="edit-btn"
                                    >
                                        Edit
                                    </a>


                                    <form
                                        action="/api/products/<%= product._id %>?_method=DELETE"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this product?')"
                                    >

                                        <button
                                            type="submit"
                                            class="delete-btn"
                                        >
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>


                        </tr>


                    <% }) %>


                <% } else { %>


                    <tr>

                        <td
                            colspan="6"
                            class="empty"
                        >

                            <div class="empty-content">

                                <div>
                                    📦
                                </div>

                                <h3>
                                    No Products Found
                                </h3>

                                <p>
                                    There are no products
                                    matching your search.
                                </p>

                            </div>

                        </td>

                    </tr>


                <% } %>


            </tbody>

        </table>

    </section>



    <!-- PAGINATION -->

    <% if (pagination) { %>

        <div class="pagination">


            <% if (pagination.page > 1) { %>

                <a
                    href="?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>&search=<%= search || '' %>"
                    class="page-btn"
                >
                    ← Previous
                </a>

            <% } %>



            <span class="page-number">

                Page
                <strong>
                    <%= pagination.page %>
                </strong>
                of
                <strong>
                    <%= pagination.pages %>
                </strong>

            </span>



            <% if (pagination.page < pagination.pages) { %>

                <a
                    href="?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>&search=<%= search || '' %>"
                    class="page-btn"
                >
                    Next →
                </a>

            <% } %>


        </div>

    <% } %>


</main>



<style>

.products-container {

    width: 90%;

    max-width: 1200px;

    margin: auto;

    padding: 45px 0;

}


/* HEADER */

.products-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 30px;

}


.page-label {

    color: #2563eb;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.5px;

    margin-bottom: 7px;

}


.products-header h1 {

    font-size: 34px;

    margin-bottom: 8px;

}


.products-header p {

    color: #6b7280;

}


/* SEARCH */

.search-form {

    display: flex;

    gap: 10px;

    margin-bottom: 25px;

}


.search-form input {

    flex: 1;

    padding: 12px 15px;

    border: 1px solid #d1d5db;

    border-radius: 7px;

    outline: none;

}


.search-form input:focus {

    border-color: #2563eb;

}


/* TABLE */

.table-card {

    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    overflow-x: auto;

}


table {

    width: 100%;

    min-width: 950px;

    border-collapse: collapse;

}


th,
td {

    padding: 16px 18px;

    text-align: left;

    border-bottom: 1px solid #e5e7eb;

}


th {

    color: #6b7280;

    font-size: 12px;

    text-transform: uppercase;

    background: #f9fafb;

}


td {

    font-size: 14px;

}


/* PRODUCT INFO */

.product-info {

    display: flex;

    align-items: center;

    gap: 12px;

}


.product-info img {

    width: 50px;

    height: 50px;

    object-fit: cover;

    border-radius: 7px;

    background: #f3f4f6;

}


.product-info strong {

    display: block;

    margin-bottom: 4px;

}


.product-info small {

    display: block;

    color: #9ca3af;

    font-size: 11px;

}


/* STATUS */

.status {

    display: inline-block;

    padding: 5px 10px;

    border-radius: 20px;

    background: #f3f4f6;

    color: #6b7280;

    font-size: 12px;

}


.status.published {

    background: #dcfce7;

    color: #15803d;

}


/* ACTIONS */

.actions {

    display: flex;

    align-items: center;

    gap: 7px;

}


.view-btn,
.edit-btn,
.delete-btn {

    border: none;

    padding: 7px 10px;

    border-radius: 5px;

    font-size: 12px;

    cursor: pointer;

}


.view-btn {

    background: #eff6ff;

    color: #2563eb;

}


.edit-btn {

    background: #fef3c7;

    color: #92400e;

}


.delete-btn {

    background: #fee2e2;

    color: #dc2626;

}


.actions form {

    display: inline;

}


/* EMPTY */

.empty {

    text-align: center;

}


.empty-content {

    padding: 50px;

}


.empty-content > div {

    font-size: 40px;

    margin-bottom: 10px;

}


.empty-content h3 {

    margin-bottom: 7px;

}


.empty-content p {

    color: #9ca3af;

}


/* PAGINATION */

.pagination {

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 20px;

    margin-top: 25px;

}


.page-btn {

    padding: 9px 14px;

    background: white;

    border: 1px solid #d1d5db;

    border-radius: 6px;

}


.page-btn:hover {

    border-color: #2563eb;

    color: #2563eb;

}


.page-number {

    color: #6b7280;

}


/* RESPONSIVE */

@media (max-width: 700px) {

    .products-header {

        flex-direction: column;

        align-items: flex-start;

        gap: 20px;

    }

}

</style>


<%- include("../partials/footer") %>